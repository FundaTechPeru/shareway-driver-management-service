# ShareWay Driver Management — example environment variables.
# Copy to .env (or set them in your deployment) and adjust. Read by Spring at startup.

# Postgres connection used by JPA. Required outside the dev/test profiles.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shareway_driver_management
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# HMAC secret used to sign and validate access tokens. REQUIRED in production:
# outside the dev/test/local profiles the service refuses to start if it is missing,
# still the development example value, or shorter than 32 characters.
# The gateway and every service that validates the token MUST share the same value,
# or callers will keep getting 401s across the platform.
JWT_SECRET=change-me-to-a-strong-32-character-plus-random-secret

# HTTP port the service listens on.
SERVER_PORT=8081

# Folder where uploaded driver documents are stored. Ignored when running the tests.
SHAREWAY_DOCUMENT_STORAGE_ROOT=./storage

# Spring profile: leave unset (or set to prod) in Render. For local runs use dev.
# SPRING_PROFILES_ACTIVE=dev
